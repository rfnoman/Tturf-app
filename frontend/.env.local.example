# ---------------------------------------------------------------------------
# Clerk  (Dashboard -> API keys)
# ---------------------------------------------------------------------------
# Publishable key, safe to expose to the browser (pk_test_... / pk_live_...)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secret key, server-side only. Never prefix this with NEXT_PUBLIC_.
CLERK_SECRET_KEY=

# Where Clerk's hosted sign-in / sign-up pages live in this app.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/play
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/play

# ---------------------------------------------------------------------------
# Django API
# ---------------------------------------------------------------------------
# Origin only: the generated schema's paths already include /api/v1.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Used by `npm run gen:api`.
NEXT_PUBLIC_API_SCHEMA_URL=http://127.0.0.1:8000/api/v1/schema/

# Public origin of this deployment, used for absolute Open Graph image URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
