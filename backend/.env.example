# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database (matches docker-compose.yml defaults)
# ---------------------------------------------------------------------------
POSTGRES_DB=turf
POSTGRES_USER=turf
POSTGRES_PASSWORD=turf
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432

# ---------------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:56379/0

# ---------------------------------------------------------------------------
# Clerk  (Dashboard -> API keys, and Dashboard -> Webhooks)
# ---------------------------------------------------------------------------
# Frontend API URL of your Clerk instance. Dashboard -> API keys.
# Dev looks like https://<slug>.clerk.accounts.dev
CLERK_FRONTEND_API_URL=
# Normally identical to CLERK_FRONTEND_API_URL; verified as the `iss` claim.
CLERK_ISSUER=
# Dashboard -> API keys -> Secret keys (sk_test_... / sk_live_...)
CLERK_SECRET_KEY=
# Dashboard -> Webhooks -> your endpoint -> Signing Secret (whsec_...)
CLERK_WEBHOOK_SIGNING_SECRET=
# Origins allowed in the token's `azp` claim (your frontend URLs)
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# GeoDjango (only needed if the Homebrew defaults in settings/base.py are wrong)
# ---------------------------------------------------------------------------
# GDAL_LIBRARY_PATH=/opt/homebrew/lib/libgdal.dylib
# GEOS_LIBRARY_PATH=/opt/homebrew/lib/libgeos_c.dylib

# ---------------------------------------------------------------------------
# Web push (Phase 09). Unset means push is simply off — no code path changes.
# Generate a pair with:  uv run python manage.py generate_vapid_keys
# The public key alone is served to the browser.
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# SSLCommerz (Phase 10). Unset means online payment is not offered and only
# cash is. Sandbox credentials are free from https://developer.sslcommerz.com
# — register a sandbox store and copy its store ID and password here.
#
# Going live additionally needs a merchant account and the server's public
# egress IP registered with SSLCommerz: they refuse refund API calls from an
# unregistered IP.
# ---------------------------------------------------------------------------
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=True
# Only for pointing the whole payment path at a local stub in development.
# SSLCOMMERZ_BASE_URL=http://127.0.0.1:8099

# ---------------------------------------------------------------------------
# Money rules (Phase 10). Per-turf values override the commission defaults.
# ---------------------------------------------------------------------------
BOOKING_DEFAULT_ADVANCE_PERCENT=25
DEFAULT_BOOKING_COMMISSION_PERCENT=10.00
DEFAULT_SALES_COMMISSION_PERCENT=5.00
